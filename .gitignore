# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing & coverage
/coverage
*.lcov

# next.js & turbo build outputs
/.next/
/out/
/build
.turbo

# debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files (never commit API keys or production secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env

# vercel & cloud
.vercel

# typescript & build info
*.tsbuildinfo
next-env.d.ts

# editor & IDE directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.idx/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# security & certificates
*.pem
*.key
*.cert

# local utility scripts & scratch tools
/scripts/